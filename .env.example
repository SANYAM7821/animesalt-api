# ==========================================
# AnimeSalt API & Web Player Environment Config
# ==========================================

# Server Port (Default: 3000)
PORT=3000

# Environment Mode (development | production)
NODE_ENV=development

# ==========================================
# Cloudflare Bypass / Scraper Proxy (Optional / Recommended for Vercel)
# ==========================================
# Cloudflare on animesalt.me challenges serverless data-center IPs (AWS/Vercel).
# Use a free Cloudflare Worker reverse proxy (100,000 req/day free) to bypass it.
# See README.md for the 2-minute Worker setup guide.
#
# Format: https://your-worker-name.your-subdomain.workers.dev
PROXY_URL=https://animesalt-proxy.v1nx.workers.dev

# Alternative rotating / commercial scraper proxy (e.g. ScraperAPI, Scrapfly, Webshare)
# Format: https://api.scraperapi.com?api_key=YOUR_API_KEY&url=
SCRAPER_PROXY=

# ==========================================
# FlareSolverr — Real Chromium Browser Bypass (MOST RELIABLE — defeats JA3 fingerprinting)
# ==========================================
# FlareSolverr runs a real Chromium browser that passes Cloudflare's Turnstile/JS challenges.
# This is the ONLY solution that fully defeats TLS JA3 fingerprint detection.
#
# Free deployment: https://render.com → New Web Service → Docker
#   Image: ghcr.io/flaresolverr/flaresolverr:latest
#   Env:   LOG_LEVEL=info
#
# Format: https://your-flaresolverr-instance.onrender.com
FLARESOLVERR_URL=
